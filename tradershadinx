(()=>{if(window.__ZK_TRADER_CHINESE_BOT_ACTIVE__)return console.warn("ZK TRADER CHINESE BOT already running.");window.__ZK_TRADER_CHINESE_BOT_ACTIVE__=1;

const BOT_NAME="ZK TRADER CHINESE BOT";

const LOGO="data:image/webp;base64,";

const KEY="zk_trader_chinese_bot_settings_v1";
const DEFAULT={delaySec:0,direction:"random"};

let S={...DEFAULT};

try{
 S={...DEFAULT,...JSON.parse(localStorage.getItem(KEY)||"{}")}
}catch{}

S.delaySec=Math.max(0,Math.min(30,+S.delaySec||0));

if(!["up","down","random"].includes(S.direction)){
 S.direction="random";
}

const st=document.createElement("style");

st.textContent=`
#zkbot{
 position:fixed;
 z-index:2147483647;
 left:16px;
 top:50%;
 transform:translateY(-50%);
 display:flex;
 flex-direction:column;
 align-items:center;
 gap:4px;
 cursor:grab;
 user-select:none;
 touch-action:none;
 filter:drop-shadow(0 2px 5px #000);
}

#zkbot img{
 width:38px;
 height:38px;
 border-radius:50%;
 object-fit:cover;
}

#zkbot b{
 font:700 10px system-ui;
 color:#fff;
 text-align:center;
 max-width:120px;
 line-height:12px;
 text-shadow:0 1px 3px #000;
}

#zkov{
 position:fixed;
 inset:0;
 z-index:2147483646;
 display:none;
 pointer-events:none;
}

#zklin{
 position:absolute;
 left:0;
 width:100%;
 height:5px;
 top:-8%;
 background:#14ad56;
 box-shadow:0 0 30px #00c864,0 0 70px #00a84f;
}

#zkov.on{
 display:block;
}

#zklin.go{
 animation:zkline 1.2s linear;
}

@keyframes zkline{
 to{top:108%}
}

#zkbd{
 position:fixed;
 inset:0;
 z-index:2147483647;
 background:#0008;
 display:none;
}

#zkp{
 position:fixed;
 z-index:2147483648;
 left:50%;
 top:50%;
 transform:translate(-50%,-50%);
 width:min(300px,calc(100vw - 32px));
 padding:16px;
 border-radius:14px;
 background:#100b16;
 color:#fff;
 border:1px solid #9400ff;
 display:none;
 font:14px system-ui;
}

#zkp.on,
#zkbd.on{
 display:block;
}

#zkp h3{
 text-align:center;
 color:#b066ff;
 margin:0 0 14px;
}

#zkp input,
#zkp button{
 box-sizing:border-box;
 width:100%;
 padding:10px;
 margin:5px 0;
 border-radius:8px;
 border:1px solid #5d2780;
 background:#18101f;
 color:#fff;
}

#zkp button.sel{
 border-color:#b066ff;
 background:#3b1654;
}
`;

document.head.appendChild(st);

const ov=document.createElement("div");
ov.id="zkov";
ov.innerHTML='<div id="zklin"></div>';
document.body.appendChild(ov);

const ln=ov.querySelector("#zklin");

const bd=document.createElement("div");
bd.id="zkbd";
document.body.appendChild(bd);

const p=document.createElement("div");
p.id="zkp";

p.innerHTML=`
<h3>${BOT_NAME} Settings</h3>

<label>Start delay (seconds)</label>

<input
 id="zkdelay"
 type="number"
 min="0"
 max="30"
 step="1"
>

<label>Trade direction</label>

<button data-x="up">Up</button>
<button data-x="down">Down</button>
<button data-x="random">Random</button>

<button id="zksave">Save</button>
`;

document.body.appendChild(p);

const d=p.querySelector("#zkdelay");
const bs=p.querySelectorAll("[data-x]");

let taps=0;
let last=0;
let timer;
let active=0;
let drag=0;
let moved=0;
let sx=0;
let sy=0;
let sl=0;
let stp=0;
let mt;

function ui(){

 d.value=S.delaySec;

 bs.forEach(b=>{
   b.classList.toggle(
     "sel",
     b.dataset.x===S.direction
   );
 });
}

function close(){

 p.classList.remove("on");
 bd.classList.remove("on");
}

function save(){

 S.delaySec=Math.max(
   0,
   Math.min(30,Math.round(+d.value||0))
 );

 S.direction=
   [...bs].find(
     b=>b.classList.contains("sel")
   )?.dataset.x || "random";

 try{
   localStorage.setItem(
     KEY,
     JSON.stringify(S)
   );
 }catch{}

 close();
 ui();
}

bs.forEach(b=>{

 b.onclick=()=>{

   bs.forEach(x=>{
     x.classList.remove("sel");
   });

   b.classList.add("sel");
 };
});

p.querySelector("#zksave").onclick=save;

bd.onclick=close;

ui();

function buttons(){

 const r=document.getElementById("trade-button");

 return r
   ?[
      r.querySelector("button.JQZcs"),
      r.querySelector("button.twQq3")
    ]
   :[];
}

function trade(){

 const [up,down]=buttons();

 const pool=[up,down].filter(Boolean);

 const selected=
   S.direction==="up"
   ?up
   :S.direction==="down"
   ?down
   :pool[
      Math.floor(
        Math.random()*pool.length
      )
    ];

 selected?.click();
}

function stop(){

 active=0;

 ov.classList.remove("on");
 ln.classList.remove("go");

 clearTimeout(mt);
}

function start(){

 if(active)return;

 active=1;

 ov.classList.add("on");

 let n=0;

 mt=setTimeout(function run(){

   if(!active)return;

   if(n++<3){

     ln.classList.remove("go");

     void ln.offsetWidth;

     ln.classList.add("go");

     mt=setTimeout(run,1200);

   }else{

     trade();
     stop();
   }

 },S.delaySec*1000);
}

function tap(){

 if(p.classList.contains("on"))return;

 const now=Date.now();

 if(now-last>500){
   taps=0;
 }

 last=now;
 taps++;

 clearTimeout(timer);

 if(taps>=3){

   taps=0;

   ui();

   p.classList.add("on");
   bd.classList.add("on");

 }else{

   timer=setTimeout(()=>{

     if(taps===1){

       if(active){
         stop();
       }else{
         start();
       }
     }

     taps=0;

   },120);
 }
}

function pos(x,y){

 const r=w.getBoundingClientRect();

 const left=Math.max(
   0,
   Math.min(
     sl+x-sx,
     innerWidth-r.width
   )
 );

 const top=Math.max(
   0,
   Math.min(
     stp+y-sy,
     innerHeight-r.height
   )
 );

 w.style.left=left+"px";
 w.style.top=top+"px";
 w.style.transform="none";
}

const w=document.createElement("div");

w.id="zkbot";

w.innerHTML=`
<img
 src="${LOGO}"
 draggable="false"
>
<b>${BOT_NAME}</b>
`;

document.body.appendChild(w);

w.onmousedown=e=>{

 drag=1;
 moved=0;

 sx=e.clientX;
 sy=e.clientY;

 const r=w.getBoundingClientRect();

 sl=r.left;
 stp=r.top;
};

document.onmousemove=e=>{

 if(!drag)return;

 if(
   Math.abs(e.clientX-sx)>8 ||
   Math.abs(e.clientY-sy)>8
 ){
   moved=1;
 }

 pos(
   e.clientX,
   e.clientY
 );
};

document.onmouseup=()=>{

 if(drag&&!moved){
   tap();
 }

 drag=0;
};

w.ontouchstart=e=>{

 const t=e.touches[0];

 drag=1;
 moved=0;

 sx=t.clientX;
 sy=t.clientY;

 const r=w.getBoundingClientRect();

 sl=r.left;
 stp=r.top;
};

w.ontouchmove=e=>{

 if(!drag)return;

 const t=e.touches[0];

 if(
   Math.abs(t.clientX-sx)>8 ||
   Math.abs(t.clientY-sy)>8
 ){
   moved=1;
 }

 pos(
   t.clientX,
   t.clientY
 );
};

w.ontouchend=()=>{

 if(drag&&!moved){
   tap();
 }

 drag=0;
};

window.__ZK_TRADER_CHINESE_BOT_STOP__=()=>{

 stop();

 w.remove();
 ov.remove();
 bd.remove();
 p.remove();
 st.remove();

 delete window.__ZK_TRADER_CHINESE_BOT_ACTIVE__;
 delete window.__ZK_TRADER_CHINESE_BOT_STOP__;
};

})();
